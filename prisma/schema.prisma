// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       Int        @id @default(autoincrement())
  username String     @unique
  password String
  vehicles Vehicles[]
}

model Vehicles {
  id           Int           @id @default(autoincrement())
  plate        String
  model        String
  brand        String
  year         Int
  current_km   Int
  maintenances Maintenance[]
  owner        Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int

  @@unique([userId, plate]) // somente uma placa por usuário
}

model Maintenance {
  id               Int      @id @default(autoincrement())
  service_part     String
  cost             Float
  km_maintenance   Int
  date_maintenance DateTime @default(now())
  vehicle          Vehicles @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId        Int
}
