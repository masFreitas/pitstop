# Supabase Transaction Pooler (porta 6543) — usado pela aplicação em runtime
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Session Pooler (porta 5432) — usado pelo Prisma CLI para rodar migrations
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Chave secreta para assinatura dos cookies de sessão (gere com: openssl rand -hex 32)
AUTH_SECRET="substitua-por-uma-chave-aleatoria-segura"
